#!/usr/bin/env escript
%%% Writes `src/roadrunner_http2_hpack_huffman_table.erl`: the HPACK
%%% Huffman tables `roadrunner_http2_hpack_huffman:tables/0` builds, as
%%% literals. Run it after changing how the tables are built:
%%%
%%%     rebar3 compile && scripts/gen_hpack_huffman_table.escript
%%%
%%% `roadrunner_http2_hpack_huffman_tests` fails while the generated
%%% module and `tables/0` disagree.

-mode(compile).

main(_Args) ->
    Root = filename:dirname(filename:dirname(filename:absname(escript:script_name()))),
    true = code:add_patha(filename:join(Root, "_build/default/lib/roadrunner/ebin")),
    {Encode, Decode, DecodeEnd} = roadrunner_http2_hpack_huffman:tables(),
    Out = filename:join(Root, "src/roadrunner_http2_hpack_huffman_table.erl"),
    ok = file:write_file(Out, [
        """
        %% Generated by scripts/gen_hpack_huffman_table.escript from
        %% roadrunner_http2_hpack_huffman:tables/0. Do not edit.
        -module(roadrunner_http2_hpack_huffman_table).
        -moduledoc false.

        -export([encode/0, decode/0, decode_end/0]).

        """,
        function(encode, Encode),
        function(decode, Decode),
        function(decode_end, DecodeEnd)
    ]),
    io:format("wrote ~s~n", [Out]).

function(Name, Tuple) ->
    Elements = [io_lib:format("~w", [E]) || E <- tuple_to_list(Tuple)],
    [
        io_lib:format("~n-spec ~s() -> tuple().~n~s() ->~n    {~n", [Name, Name]),
        lines(Elements),
        "\n    }.\n"
    ].

%% Sixteen elements to a line.
lines(Elements) when length(Elements) > 16 ->
    {Line, Rest} = lists:split(16, Elements),
    [line(Line), ",\n" | lines(Rest)];
lines(Elements) ->
    line(Elements).

line(Elements) ->
    ["        ", lists:join(", ", Elements)].
